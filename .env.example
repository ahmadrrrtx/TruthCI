# TruthCI local defaults
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local SQLite. On Vercel, use Turso variables below instead.
DATABASE_PATH=./data/truthci.db

# Vercel production database: Turso/libSQL, SQLite-compatible.
# Required for durable data on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI - primary
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# AI - fallback
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-70b

# Crawler
CRAWL_MAX_PAGES=5
CRAWL_PAGE_TIMEOUT_MS=12000
SCREENSHOT_DIR=./storage/screenshots

# Optional local override if @sparticuz/chromium cannot launch on your machine.
# Example macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Example Linux: /usr/bin/google-chrome
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
